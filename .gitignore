# Ignore media recordings in workspace root
*.mp4
*.pdf

# Ignore root-level images only (not portfolio assets)
/image.png

# Ignore node_modules and builds in portfolio subfolder
portfolio/node_modules/
portfolio/.next/
portfolio/out/
portfolio/build/
portfolio/next-env.d.ts
portfolio/*.tsbuildinfo

# Ignore debug logs
*debug.log*
yarn-error.log*
